# Copy to .env for local dev (never commit .env). Set the same keys in Vercel > Project > Settings > Environment Variables.

# --- Required ---
# Neon project kennesaw-barber-shop (fancy-dew-48860076). Pooled connection string from the Neon console.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Long random string used to sign admin sessions. Generate: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string
# First admin login. `npm run seed` (or the first login attempt) creates it if no admin exists yet.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-at-least-10-chars
ADMIN_NAME=Jon
# Public origin, used in email links and the Square OAuth redirect. No trailing slash.
PUBLIC_SITE_URL=https://kennesaw-barber-shop.vercel.app

# --- Optional booking tuning ---
# Local request mode only (before Square is connected): clients allowed per start time. Default 3.
BOOKING_CHAIRS=3

# --- Email (Resend). Without RESEND_API_KEY, emails are logged and bookings still work. ---
RESEND_API_KEY=
# Use onboarding@resend.dev until the shop domain is verified in Resend.
RESEND_FROM=Kennesaw Barber Shop <onboarding@resend.dev>
# Where new booking alerts go. Defaults to ADMIN_EMAIL.
ADMIN_NOTIFY_EMAIL=

# --- Square Appointments (source of truth when connected) ---
# Location is already known: 6GE8HGYZE2KXZ (auto-picked on Connect).
# sandbox or production
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# Optional. Defaults to <origin>/api/admin/square/callback
SQUARE_REDIRECT_URI=
# Optional, for testing without OAuth: a personal access token from the Square Developer Dashboard.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=6GE8HGYZE2KXZ
# Optional: limit online booking to one barber. Leave blank so clients can book any barber.
SQUARE_TEAM_MEMBER_ID=
# true only if the shop is on Square Appointments Plus or Premium (unlocks seller-level writes).
SQUARE_SELLER_LEVEL_WRITES=false
# Optional: Square webhook (instant menu, hours, and booking sync). Key from Developer Dashboard > Webhooks.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://kennesaw-barber-shop.vercel.app/api/square/webhook

# --- Vercel Cron: daily Square sync. Vercel sends it as a Bearer token. ---
CRON_SECRET=replace-with-a-random-string
